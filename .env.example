# SEC EDGAR requires a descriptive User-Agent: "Your Name your@email"
SEC_USER_AGENT=Your Name your@email.com

# Phase 2 - OpenAI
OPENAI_API_KEY=

# Phase 8 - Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_10k_chunks

# Phase 11 - reranker (bge-reranker-large for the A/B in Phase 14)
RERANKER_MODEL=BAAI/bge-reranker-base
CHAT_MODEL=gpt-4o-mini

# Phase 16 - public deployment abuse guardrail
MAX_QUERIES_PER_SESSION=20
